# Optional. The app ships with the PUBLIC production Supabase values baked in
# (see src/lib/supabase.ts), so it runs with no .env at all. Only set these to
# point the app at a different (e.g. staging) Supabase project.
EXPO_PUBLIC_SUPABASE_URL=https://api.wyberai.com
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# In-app purchases (Google Play Billing via RevenueCat). All PUBLIC (baked into
# the build). Set these in the build environment (GitHub Actions repo variables)
# to turn IAP on. Left unset → IAP is off and the paywall shows a calm
# "install the app" notice (never a dead-end).
#   EXPO_PUBLIC_ENABLE_IAP=true                 # flip on once RevenueCat + Play products exist
#   EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_... # RevenueCat Android PUBLIC SDK key
#   EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...     # (iOS, later)
#   EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_...    # RevenueCat Test Store (dev/preview fallback)
#
# Server side (set on wyberai / Vercel prod, NOT here) — the credit webhook:
#   REVENUECAT_WEBHOOK_SECRET   = the Authorization value configured in RevenueCat
#   REVENUECAT_TOPUP_200/600/2000 = the Play Console product IDs for each credit pack

# Agent-team feed (Atlas/Forge/Prism/Sentinel/Verity live status during a build).
# Mirrors the web app's NEXT_PUBLIC_AGENT_TEAM — same name, EXPO_PUBLIC_ prefix.
# The events themselves are emitted by wyberai.com's /api/generate (which mobile
# already calls); this only gates whether the mobile UI renders the feed. Left
# unset → src/lib/agents/events.ts still parses cleanly, the feed just never
# has anything to show.
#   EXPO_PUBLIC_AGENT_TEAM=true
